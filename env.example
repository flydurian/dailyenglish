# 서버 전용 Gemini API 키입니다. (Vercel: Project Settings > Environment Variables)
# REACT_APP_ 접두사를 붙이면 브라우저 번들에 노출되므로 사용하지 마세요.
# https://ai.google.dev/ 에서 발급할 수 있습니다.
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) Google Cloud TTS 서브 — Gemini TTS 한도 소진 시 미국/영국 발음 모두 자동 사용.
# 4개 값이 모두 있어야 켜지고, 없으면 과금 방지를 위해 조용히 건너뜁니다.
# 자세한 설정 방법은 README의 "Google Cloud TTS 서브"를 참고하세요.
# GOOGLE_TTS_API_KEY=your_google_cloud_tts_key
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# GOOGLE_TTS_MONTHLY_LIMIT=900000
# GOOGLE_TTS_IP_MONTHLY_LIMIT=100000
# GOOGLE_TTS_VOICE=en-GB-Chirp3-HD-Achernar
# GOOGLE_TTS_VOICE_US=en-US-Chirp3-HD-Kore

# 웹 개발 서버 포트
PORT=3002
# 로컬 뉴스/Gemini API 서버 포트 (npm run dev 시 사용)
DEV_API_PORT=3101
